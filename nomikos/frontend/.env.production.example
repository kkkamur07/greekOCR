# Vercel production build env for app.nomikos.app
# Set these in the Vercel project → Settings → Environment Variables.

NEXT_PUBLIC_API_BASE_URL=https://api.nomikos.app
NEXT_PUBLIC_CSRF_COOKIE_NAME=greekocr-csrf

# There is deliberately no variable here pointing at a local inference process.
# ADR 0002 deleted the browser-to-loopback call: the **inference agent** the
# researcher runs (`nomikos run`) reaches the platform outbound, so this app
# never addresses it and the frontend CSP permits no loopback origin.

NEXT_PUBLIC_ENABLE_TEST_JOBS=false
