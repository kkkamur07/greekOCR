# Copy to .env and adjust for local development.
# Relative paths resolve from the nomikos/ app root unless noted.

# Filesystem root (relative paths resolve from nomikos/ project root; default: data)
NOMIKOS_DATA_ROOT=data

# Local API bind (uvicorn when not using Docker)
NOMIKOS_HOST=127.0.0.1
NOMIKOS_PORT=5050

# Comma-separated browser origins for CORS
NOMIKOS_CORS_ORIGINS=http://localhost:3000

# Hot reload for local uvicorn
NOMIKOS_RELOAD=true
