# Docker Compose development variables. Copy to the repository-root `.env`,
# choose a unique local-only password, and never commit the filled file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=kalamos

# Development-only service secrets. Replace before any shared deployment.
JWT_SECRET=replace-with-a-local-only-jwt-secret-at-least-32-bytes
# Authenticates the job callback an inference agent posts back to the API.
INFERENCE_WEBHOOK_SECRET=replace-with-a-local-only-webhook-secret

# Device pairing. Keep DEVICE_TOKEN_HMAC_SECRET distinct from JWT_SECRET:
# it keys every device token, so sharing the key means rotating JWT_SECRET
# unpairs every researcher's laptop, which needs a terminal to recover from.
# Unset, it falls back to JWT_SECRET in development; production refuses to start.
DEVICE_TOKEN_HMAC_SECRET=replace-with-a-local-only-device-secret-32-bytes
# Unset means on outside production, off in production until the /pair page ships.
# This also gates the claim endpoint, so it is the one switch for the whole
# outbound agent layer - hosted workers included.
DEVICE_PAIRING_ENABLED=true

# The hosted worker's credential for the same claim endpoint a laptop uses
# (ADR 0003). Unlike a device token it is scoped to no account, because cloud
# work belongs to the platform rather than to one researcher - so it is held to
# the same 32-character floor, and unset means no hosted worker can claim.
INFERENCE_WORKER_SERVICE_TOKEN=replace-with-a-local-only-worker-token-32-bytes
# How long one claimed page stays with the agent that took it. There is no
# heartbeat endpoint: work is seconds-to-minutes, so this covers it with margin
# and a slept laptop loses one page rather than a document.
DEVICE_LEASE_SECONDS=600
# Ceiling on one claim's long poll. A laptop waits; a hosted worker sends 0.
DEVICE_CLAIM_MAX_WAIT_SECONDS=25
# How long the signed page image link in a claim response stays usable. NOT the
# lease and deliberately not derived from it (ADR 0002): the agent downloads the
# image once, right after claiming, so this only has to cover one large scan on
# a bad connection. A bearer token in a URL should not outlive its one use.
DEVICE_PAGE_IMAGE_URL_TTL_SECONDS=60
# Keys those links when STORAGE_BACKEND=local, where the platform signs and
# serves the object itself. Unused on Supabase, which signs with Storage's own
# key. Falls back to JWT_SECRET - a rotation costs at most a link with under a
# minute left, and the agent simply claims again.
# MEDIA_URL_SIGNING_SECRET=

# Oldest agent allowed to claim (ADR 0002). Below it, the claim is refused with
# 426 and the agent must upgrade; an agent that states no version, or an
# unparseable one, is refused too rather than assumed current. Turnable here
# rather than read from PyPI so a known-bad build can be stopped without a
# release. Comparison is numeric: 0.10.0 is above a 0.9.0 floor.
INFERENCE_AGENT_MIN_VERSION=0.1.0
# Newest published agent. At or above the floor but below this is served and told
# it is outdated - a notice, not a refusal. Unset means "same as the floor".
# INFERENCE_AGENT_LATEST_VERSION=
