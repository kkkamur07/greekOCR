# Supabase profile for platform database + storage.
# Copy to backend/core/.env.supabase and fill in credentials. Never commit the filled file.

# --- Database (Supabase Postgres, database name: postgres) ---
# Fill these from your provider's secret store, never from a tracked file.
# Direct operator/migrator connection for Alembic only:
MIGRATOR_DATABASE_URL=

# Runtime nomicous_api connection(s). The transaction pooler needs asyncpg
# statement caching disabled; infrastructure/db.py does that automatically.
DATABASE_URL=
SYNC_DATABASE_URL=

# --- Storage (private bucket for document part page images) ---
STORAGE_BACKEND=supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=document-media

# WebP encoding (lossless by default for OCR fidelity)
MEDIA_WEBP_LOSSLESS=true
# MEDIA_WEBP_QUALITY=95

# --- App secrets (generate for each environment) ---
ENVIRONMENT=development
# Opt this project in to `scripts/platform/reset_supabase_nonprod.sh`, which drops
# the application schema. The script parses this key out of *this file* and ignores
# any exported shell value, so a disposable project must declare it here or the
# reset refuses to run. Never uncomment for a production project.
# SUPABASE_NON_PRODUCTION=true
JWT_SECRET=replace-with-at-least-32-byte-secret
CORS_ORIGINS=http://localhost:5173,https://app.nomicous.com

INFERENCE_WEBHOOK_SECRET=replace-me

# The Compose API is request/response only; its separate platform-worker claims jobs.
JOB_WORKER_ENABLED=false
JOB_SSE_NOTIFICATIONS_ENABLED=false
